{
  "expo": {
    "name": "NESTORA",
    "slug": "nestora-android",
    "version": "1.0.0",
    "scheme": "nestora",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-light.png",
          "imageWidth": 320,
          "backgroundColor": "#F8F6F2",
          "dark": {
            "image": "./assets/splash-dark.png",
            "backgroundColor": "#191A16"
          }
        }
      ],
      [
        "expo-sqlite",
        {
          "enableFTS": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "com.nestora.store",
      "adaptiveIcon": {
        "backgroundColor": "#F8F6F2"
      },
      "versionCode": 3
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ad6628dc-29c2-4022-8948-c196ed48b981"
      }
    },
    "owner": "codesigner-jmk"
  }
}
